# Participant demo configuration — copy to .env and fill in real values.
# NEVER commit the .env file or the *-key.pem certificate material.

# HTTP port for the demo Express app.
NODE_PORT=3000
# Unique node id (used in local file names).
NODE_ID=node-demo
# Coordinator gRPC address (host:port).
# TLS modes (shared-secret/mtls): use the HOSTNAME form — grpc-js sets the
# TLS SNI servername from the authority and rejects IP literals there.
COORDINATOR_ADDRESS=localhost:50100

# Auth — must be compatible with the coordinator's AUTH_MODE.
AUTH_MODE=shared-secret
# Shared secret — >= 16 chars, identical on the coordinator and every node.
REVOKER_SECRET=change-me-at-least-16-chars
# CA that signed the coordinator certificate (generated by gen-certs.mjs;
# paths are relative to this example directory when run as documented)
NODE_CA_CERT_PATH=../../../../certs/ca-cert.pem
# mtls only — one client keypair per node:
#NODE_CLIENT_CERT_PATH=../../../../certs/client-cert.pem
#NODE_CLIENT_KEY_PATH=../../../../certs/client-key.pem

# Filter geometry — MUST match the coordinator.
#REVOKER_NUM_ITEMS=1000000
#REVOKER_FP_RATE=1e-9
#REVOKER_ROTATE_TIME_MS=900000
