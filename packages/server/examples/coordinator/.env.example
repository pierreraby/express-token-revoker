# Coordinator demo configuration — copy to .env and fill in real values.
# NEVER commit the .env file or deployment *-key.pem material — the keypairs
# under /fixtures are throwaway TEST-ONLY certificates (see fixtures/README.md).

# gRPC port the coordinator binds.
COORDINATOR_PORT=50100
# Bind host (127.0.0.1 = loopback only).
COORDINATOR_HOST=127.0.0.1

# Auth (PD-1): shared-secret (default) | mtls | insecure (dev-only).
AUTH_MODE=shared-secret
# Shared secret — >= 16 chars, identical on the coordinator and every node.
REVOKER_SECRET=change-me-at-least-16-chars

# TLS material — generate first with: node scripts/gen-certs.mjs
# (paths are relative to this example directory when run as documented)
COORDINATOR_CA_CERT_PATH=../../../../certs/ca-cert.pem
COORDINATOR_SERVER_CERT_PATH=../../../../certs/server-cert.pem
COORDINATOR_SERVER_KEY_PATH=../../../../certs/server-key.pem

# Optional filter overrides — MUST match on every participant node.
#REVOKER_NUM_ITEMS=1000000
#REVOKER_FP_RATE=1e-9
#REVOKER_ROTATE_TIME_MS=900000
#REVOKER_BACKUP_RATIO_TIME=4
