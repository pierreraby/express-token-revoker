{
  "name": "@express-token-revoker/server",
  "version": "0.1.0",
  "private": true,
  "description": "Distributed coordinator for express-token-revoker — owns the canonical WAL and coordinated rotation, streams ordered revocation deltas to participant nodes over gRPC.",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    }
  },
  "files": [
    "build"
  ],
  "keywords": [
    "express",
    "token",
    "revocation",
    "bloom-filter",
    "distributed",
    "coordinator",
    "grpc"
  ],
  "author": "Pierre Raby",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pierreraby/express-token-revoker.git"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.5",
    "@grpc/proto-loader": "^0.7.13",
    "express-token-revoker": "workspace:*",
    "joi": "^17.13.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
