{
  "name": "express-jwt-revoker",
  "version": "1.0.0",
  "description": "",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env ./examples/standalone/app.js",
    "dev": "nodemon --env-file=.env ./examples/standalone/app.js",
    "client": "node --env-file=.env ./examples/standalone/client.js",
    "test": "vitest run",
    "build": "tsc && mkdir -p build/grpc/protos && cp -r dist/grpc/protos/. build/grpc/protos/",
    "clear": "node -e \"const fs=require('fs'); const path=require('path'); const dir='./backup'; if(fs.existsSync(dir)) fs.readdirSync(dir).forEach(f => fs.rmSync(path.join(dir, f)))\"",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "imports": {
    "#dist/*": "./build/*",
    "#logger": "./examples/logger.js"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.5",
    "@grpc/proto-loader": "^0.7.13",
    "async-mutex": "^0.5.0",
    "express": "^4.21.2",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "throttleit": "^2.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^26.1.2",
    "@types/supertest": "^7.2.1",
    "@types/throttleit": "^1.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "nodemon": "^3.1.9",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
