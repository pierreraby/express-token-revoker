{
  "name": "express-jwt-revoker",
  "version": "1.0.0",
  "description": "",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env ./examples/standalone/app.js",
    "dev": "nodemon --env-file=.env ./examples/standalone/app.js",
    "client": "node --env-file=.env ./examples/standalone/client.js",
    "test": "c8 node bin/test.js",
    "build": "tsc && mkdir -p build/grpc/protos && cp -r dist/grpc/protos/. build/grpc/protos/",
    "clear": "node -e \"const fs=require('fs'); const path=require('path'); const dir='./backup'; if(fs.existsSync(dir)) fs.readdirSync(dir).forEach(f => fs.rmSync(path.join(dir, f)))\""
  },
  "imports": {
    "#dist/*": "./build/*",
    "#logger": "./examples/logger.js"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.5",
    "@grpc/proto-loader": "^0.7.13",
    "async-mutex": "^0.5.0",
    "express": "^4.21.2",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "throttleit": "^2.1.0"
  },
  "devDependencies": {
    "@japa/api-client": "^2.0.4",
    "@japa/expect": "^3.0.2",
    "@japa/runner": "^3.1.4",
    "@types/express": "^4.17.25",
    "@types/node": "^26.1.2",
    "@types/throttleit": "^1.0.2",
    "c8": "^10.1.3",
    "nodemon": "^3.1.9",
    "sinon": "^19.0.2",
    "typescript": "^7.0.2"
  }
}